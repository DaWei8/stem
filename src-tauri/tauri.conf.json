{
  "productName": "STEM",
  "version": "0.1.0",
  "identifier": "com.stem.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../frontend/public"
  },
